{
  // ระบบรายงานผลการเรียน โรงเรียนวัดโบสถ์ (ราษฎร์รังสฤษฏ์) — Cloudflare Worker + D1
  // ฐานข้อมูล D1 ชื่อ watbot_report_db (สร้างแล้ว — database_id ด้านล่าง)
  // และตั้ง Secret ชื่อ JWT_SECRET (ข้อความสุ่มยาว ๆ) ที่ Settings → Variables and Secrets ของ Worker
  "name": "watbot-students-report",
  "keep_vars": true,
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watbot_report_db",
      "database_id": "e66ba1d3-25b7-4f22-9daf-ee3357c0beea"
    }
  ],
  "observability": { "enabled": true }
}
