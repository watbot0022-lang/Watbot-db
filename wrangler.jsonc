{
  "name": "watbot-report-db",
  "keep_vars": true,
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watbot_report_db",
      "database_id": "9797d04b-8d50-412e-8659-7a75d9625892"
    }
  ],
  "vars": { "SETUP_ADMIN_EMAIL": "sattawat.imc@gmail.com" },
  "observability": { "enabled": true }
}
