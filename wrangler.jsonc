{
  // ระบบรายงานผลการเรียน โรงเรียนวัดโบสถ์ (ราษฎร์รังสฤษฏ์) — Cloudflare Worker + D1
  // ฐานข้อมูล D1 watbot_report_db ในบัญชี Cloudflare ของโรงเรียนวัดโบสถ์
  // และตั้ง Secret ชื่อ JWT_SECRET (ข้อความสุ่มยาว ๆ) ที่ Settings → Variables and Secrets ของ Worker
  "name": "watbot-students-report",
  "keep_vars": true,
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watbot_report_db",
      "database_id": "9797d04b-8d50-412e-8659-7a75d9625892"
    }
  ],
  "observability": { "enabled": true }
}
